# Security Settings
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-here

# Allowed Hosts and CORS origins (Comma separated)
# Replace with your actual Vercel and GitHub Pages domains!
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,.github.io
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app,https://your-username.github.io

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# 1. For Local SQLite (Default)
# DATABASE_URL=sqlite:///db.sqlite3

# 2. For Supabase / PostgreSQL (Production)
# Uncomment the line below and replace with your Supabase Transaction pooler or Session connection string
# DATABASE_URL=postgresql://postgres:PZygWwHc!58qqWx@db.wjmeceftmziptmblzkjz.supabase.co:5432/postgres

# Example Supabase format (ensure you use the correct port, usually 6543 or 5432):
# DATABASE_URL=postgres://postgres.your_project_ref:your_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
